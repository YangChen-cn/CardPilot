{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardPilot Agent Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bank",
        "name",
        "network",
        "sourceURL",
        "verifiedOn",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bank": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "annualFeeNote": {
          "type": "string"
        },
        "caveats": {
          "type": "string"
        },
        "imageBase64": {
          "type": "string"
        },
        "network": {
          "enum": [
            "Visa",
            "Mastercard",
            "UnionPay",
            "American Express",
            "其他"
          ]
        },
        "kind": {
          "enum": [
            "信用卡",
            "借记卡"
          ]
        },
        "sourceURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "verifiedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "imageURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "baseRatePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        },
        "foreignFeePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        },
        "overseasHKDFeePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        },
        "excludesWallets": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "calculation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cnyFeeBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "baseRewardBasis": {
              "enum": [
                "hkd",
                "faceValue"
              ]
            },
            "baseCapUsesCreditLimit": {
              "type": "boolean"
            },
            "baseCapPeriod": {
              "enum": [
                "monthly",
                "statement"
              ]
            },
            "cnyFeeRegions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "HK",
                  "CN",
                  "MO",
                  "other"
                ]
              }
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "startsOn",
        "endsOn",
        "sourceURL"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sharedCapGroup": {
          "type": "string"
        },
        "merchantKeywords": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "cashback",
            "welcome"
          ]
        },
        "startsOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endsOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sourceURL": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "ratePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.01
        },
        "capPeriod": {
          "enum": [
            "monthly",
            "campaign"
          ]
        },
        "channelCondition": {
          "enum": [
            "any",
            "physical",
            "online",
            "overseasForeign",
            "onlineOrOverseasForeign"
          ]
        },
        "category": {
          "enum": [
            "",
            "餐饮",
            "超市",
            "购物",
            "交通",
            "旅行",
            "缴费",
            "娱乐",
            "其他"
          ]
        },
        "currency": {
          "enum": [
            "",
            "HKD",
            "CNY",
            "USD"
          ]
        },
        "paymentMethod": {
          "enum": [
            "",
            "Apple Pay",
            "实体卡",
            "网上支付",
            "支付宝",
            "微信支付",
            "云闪付",
            "BoC Pay",
            "Huawei Pay",
            "PayMe"
          ]
        },
        "requiresPersonalDates": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "capHKD": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000000,
          "multipleOf": 0.01
        },
        "thresholdHKD": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000000,
          "multipleOf": 0.01
        },
        "bonusHKD": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000000,
          "multipleOf": 0.01
        },
        "minimumHKD": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000000,
          "multipleOf": 0.01
        },
        "monthlyPhysicalThresholdHKD": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000000,
          "multipleOf": 0.01
        },
        "calculation": {
          "$ref": "#/$defs/calculation"
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "perTransactionCapCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000000
        },
        "minimumOriginalCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000000
        },
        "monthlyLocalThresholdCents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000000
        },
        "stackingGroup": {
          "type": "string"
        },
        "capScope": {
          "type": "string"
        },
        "rateMode": {
          "enum": [
            "total",
            "extra"
          ]
        },
        "currencyCondition": {
          "enum": [
            "any",
            "foreign"
          ]
        },
        "rewardBasis": {
          "enum": [
            "hkd",
            "faceValue"
          ]
        },
        "capIncludesBase": {
          "type": "boolean"
        },
        "welcomeMode": {
          "enum": [
            "fixed",
            "percentage"
          ]
        },
        "regions": {
          "type": "array",
          "items": {
            "enum": [
              "HK",
              "CN",
              "MO",
              "other"
            ]
          }
        },
        "paymentMethods": {
          "type": "array",
          "items": {
            "enum": [
              "Apple Pay",
              "实体卡",
              "网上支付",
              "支付宝",
              "微信支付",
              "云闪付",
              "BoC Pay",
              "Huawei Pay",
              "PayMe"
            ]
          }
        },
        "excludedPaymentMethods": {
          "type": "array",
          "items": {
            "enum": [
              "Apple Pay",
              "实体卡",
              "网上支付",
              "支付宝",
              "微信支付",
              "云闪付",
              "BoC Pay",
              "Huawei Pay",
              "PayMe"
            ]
          }
        },
        "excludedCategories": {
          "type": "array",
          "items": {
            "enum": [
              "餐饮",
              "超市",
              "购物",
              "交通",
              "旅行",
              "缴费",
              "娱乐",
              "其他"
            ]
          }
        },
        "periodUnverified": {
          "type": "boolean",
          "default": false,
          "description": "活动日期未核实；兼容存储日期不用于展示真实有效期或提醒。"
        }
      }
    }
  }
}
